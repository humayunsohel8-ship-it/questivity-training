# ─── Supabase (Project Settings → API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never expose to the browser. Used by admin screens only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ─── Claude — OPTIONAL (console.anthropic.com → API keys) ─────────────
# Leave empty to run Quest Assistant in search mode (lists matching KB articles).
# With a key, an admin can switch AI answers on/off in Admin → Settings.
ANTHROPIC_API_KEY=
# Any current Claude model id. Sonnet is a good balance of quality/cost.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── App ──────────────────────────────────────────────────────────────
# Public URL of the site (your custom domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated list of email domains allowed to sign in. Leave empty to allow any.
ALLOWED_EMAIL_DOMAINS=questivity.com
# Assistant rate limit: max questions per user per hour
ASSISTANT_HOURLY_LIMIT=60

# ─── Microsoft 365 / Outlook invites — OPTIONAL ───────────────────────
# Entra ID app registration with Application permission Calendars.ReadWrite
# (admin consent granted). Without these, live classes use .ics files and
# "Add to Outlook" links instead.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Mailbox that organises the meetings, e.g. training@questivity.com
MS_GRAPH_ORGANIZER=
